{
  "name": "aura-dent",
  "version": "0.1.0",
  "description": "Sistema de reserva de citas odontológicas con asistente IA y pagos por QR, bajo arquitectura hexagonal",
  "main": "dist/servidor_principal.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/servidor_principal.ts",
    "build": "tsc",
    "start": "node dist/servidor_principal.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:setup": "ts-node --transpile-only scripts/preparar_bd.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
