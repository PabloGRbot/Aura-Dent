PORT=3000
NODE_ENV=development

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=AuraDent

# --- Autenticación JWT ---
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES=8h

# --- Frontend (CORS) ---
FRONTEND_URL=http://localhost:5173

# --- Asistente virtual IA (Chatbot) ---
# Endpoint compatible con OpenAI "chat/completions".
# Por defecto: Google Gemini (capa gratuita).
#   1) Crea una API key gratis en https://aistudio.google.com/apikey
#   2) Pega la key en OPENAI_KEY.
# Si dejas el valor de ejemplo, el chatbot usa el motor local
# (coincidencia sobre base_conocimiento_chatbot) y funciona sin internet.
#
# Otros proveedores gratuitos y compatibles (mismo formato):
#   Groq:       https://api.groq.com/openai/v1/chat/completions   modelo: llama-3.3-70b-versatile
#   OpenRouter: https://openrouter.ai/api/v1/chat/completions    modelo: <modelo>:free
#   Cerebras:   https://api.cerebras.ai/v1/chat/completions
#   Ollama:     http://localhost:11434/v1/chat/completions       (local, sin key)
OPENAI_KEY=tu-gemini-api-key-aqui
OPENAI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
OPENAI_MODEL=gemini-3.5-flash-lite

# --- Pasarela de pagos (demo) ---
PAY_KEY=tu-llave-pago
PAY_URL=https://api.culqi.com/v2

# --- Correo (RF17) ---
# Si no se configura SMTP, las notificaciones se imprimen en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aura Dent <no-reply@auradent.pe>
